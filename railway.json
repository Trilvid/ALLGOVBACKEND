{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS"
    },
    "deploy": {
        "startCommand": "npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    },
    "cron": [
        {
            "name": "Auto-Renew Subscriptions",
            "schedule": "0 1 * * *",
            "command": "curl -H \"x-cron-api-key: $CRON_API_KEY\" https://$RAILWAY_PUBLIC_DOMAIN/api/cron/auto-renew"
        },
        {
            "name": "Check Expiring Subscriptions",
            "schedule": "0 9 * * *",
            "command": "curl -H \"x-cron-api-key: $CRON_API_KEY\" https://$RAILWAY_PUBLIC_DOMAIN/api/cron/check-expiring-subscriptions"
        },
        {
            "name": "Update Expired Subscriptions",
            "schedule": "0 0 * * *",
            "command": "curl -H \"x-cron-api-key: $CRON_API_KEY\" https://$RAILWAY_PUBLIC_DOMAIN/api/cron/update-expired-subscriptions"
        },
        {
            "name": "Check Low Wallet Balances",
            "schedule": "0 10 * * *",
            "command": "curl -H \"x-cron-api-key: $CRON_API_KEY\" https://$RAILWAY_PUBLIC_DOMAIN/api/cron/check-low-balances"
        },
        {
            "name": "Send KYC Reminders",
            "schedule": "0 11 * * *",
            "command": "curl -H \"x-cron-api-key: $CRON_API_KEY\" https://$RAILWAY_PUBLIC_DOMAIN/api/cron/kyc-reminders"
        },
        {
            "name": "Cleanup Old Notifications",
            "schedule": "0 2 * * 0",
            "command": "curl -H \"x-cron-api-key: $CRON_API_KEY\" https://$RAILWAY_PUBLIC_DOMAIN/api/cron/cleanup-notifications"
        }
    ]
}